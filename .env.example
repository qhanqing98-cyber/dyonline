# ============================================================
# DY·ONLINE 配置模板
# 用法：复制成 .env 后按需修改（.env 已被 .gitignore 忽略，不会进仓库）
# ============================================================

# ---------- 服务监听 ----------
# 本机开发用 127.0.0.1；服务器上改成 0.0.0.0 才能被外部访问
HOST=127.0.0.1
PORT=8000

# ---------- 访问鉴权 ----------
# 留空 = 不鉴权（仅本机开发）。公网部署必须设置一个长口令！
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(32))"
ACCESS_TOKEN=
# HTTPS 部署时设为 true，防止 Cookie 在明文信道上被窃取
COOKIE_SECURE=false

# ---------- 并发与队列 ----------
# 2 核 2G 服务器建议 2；4G 内存可给 3~4。每个无头浏览器约占 150-300MB
MAX_CONCURRENCY=2
QUEUE_LIMIT=20

# ---------- 入参与磁盘保护 ----------
MAX_LINKS_PER_TASK=20
MIN_FREE_MB=2048

# ---------- 抖音引擎 ----------
# 本机（Windows，有 Edge）：msedge
# 云服务器（Linux，无 Edge）：chromium
DOUYIN_ENGINE=msedge
# 服务器上没有浏览器登录态，需要手动注入抖音 cookie（形如 ttwid=xxx; msToken=xxx）
DOUYIN_COOKIE=

# ---------- B 站 ----------
# 下载 1080P 需要登录态（SESSDATA=xxx）
BILI_COOKIE=

# ---------- 路径（留空则用项目内默认目录） ----------
# DOWNLOAD_DIR=
# DATA_DIR=
# DB_PATH=
