# ============================================================
# DY·ONLINE 配置模板
# 用法：复制成 .env 后按需修改（.env 已被 .gitignore 忽略，不会进仓库）
# ============================================================

# ---------- 服务监听 ----------
# 本机开发用 127.0.0.1；服务器上改成 0.0.0.0 才能被外部访问
HOST=127.0.0.1
PORT=8000

# ---------- 初始管理员（仅首次初始化生效） ----------
# 登录始终启用。密码至少 8 个字符；也可用 python -m app.users create admin --admin 创建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 兼容旧部署：无 ADMIN_PASSWORD 时以旧 ACCESS_TOKEN 初始化管理员，不再共享登录。
ACCESS_TOKEN=
# HTTPS 部署时设为 true，防止 Cookie 在明文信道上被窃取
COOKIE_SECURE=false

# ---------- 并发与队列 ----------
# 2 核 2G 服务器建议 2；4G 内存可给 3~4。每个无头浏览器约占 150-300MB
MAX_CONCURRENCY=2
QUEUE_LIMIT=20
# 每用户最多 3 个排队中或下载中的任务，管理员同样受限
USER_QUEUE_LIMIT=3

# ---------- 入参与磁盘保护 ----------
MAX_LINKS_PER_TASK=20
MIN_FREE_MB=2048

# ---------- 抖音引擎 ----------
# 本机（Windows，有 Edge）：msedge
# 云服务器（Linux，无 Edge）：chromium
DOUYIN_ENGINE=msedge
# 服务器上没有浏览器登录态，需要手动注入抖音 cookie（形如 ttwid=xxx; msToken=xxx）
DOUYIN_COOKIE=

# ---------- B 站 ----------
# 下载 1080P 需要登录态（SESSDATA=xxx）
BILI_COOKIE=

# ---------- 路径（留空则用项目内默认目录） ----------
# DOWNLOAD_DIR=
# DATA_DIR=
# DB_PATH=

# ---------- 视频定期清理及抖音等待 ----------
DOWNLOAD_RETENTION_HOURS=24
DOWNLOAD_CLEANUP_INTERVAL_SECONDS=3600
DOUYIN_NAVIGATION_TIMEOUT_MS=30000
DOUYIN_MEDIA_TIMEOUT_MS=30000

# ---------- 运维日志 ----------
# DEBUG / INFO / WARNING / ERROR / CRITICAL；默认 INFO
LOG_LEVEL=INFO
